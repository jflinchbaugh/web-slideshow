;; shadow-cljs configuration for com/hjsoft/slideshow
{:source-paths
 ["src/main"
  "src/test"]
 :dependencies
 [[lilactown/helix "0.3.0"]
  [com.taoensso/telemere "1.4.0"]
  [tick/tick "1.0.3"]
  [cljs-http "0.1.49"]
  [binaryage/devtools "1.0.7"]
  [cider/cider-nrepl "0.64.1"]
  [refactor-nrepl "3.16.0"]]
 :dev-http
 {3000
  {:root "public"
   :handler com.hjsoft.slideshow.dev-server/handle}}
 :builds
 {:frontend
  {:target :browser
   :output-dir "public/js"
   :asset-path "js"
   :modules
   {:main {:init-fn com.hjsoft.slideshow.app/init}}
   :build-hooks
   [[com.hjsoft.slideshow.build-hooks/version-cljs]
    [com.hjsoft.slideshow.build-hooks/version-index-resources]]}

  :test
  {:target :node-test
   :main node/main
   :output-to "out/node-tests.js"
   :autorun true
   :build-hooks
   [[com.hjsoft.slideshow.build-hooks/version-cljs]]}}}
